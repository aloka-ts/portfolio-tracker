---
import Layout from '../layouts/Layout.astro';
import DashboardShell from '../components/dashboard/DashboardShell';
---

<Layout title="Dashboard | Stock Portfolio Analytics">
  <DashboardShell client:load />
</Layout>

{/* Client script to boot price tickers */}
<script>
  import { startPriceSubscription } from '../stores/prices';
  import { portfolioStore } from '../stores/portfolio';
  
  // Start the background subscription
  const unsubscribe = startPriceSubscription(portfolioStore);
  
  // Gracefully clean up on page teardown
  document.addEventListener('astro:before-swap', () => {
    if (unsubscribe) unsubscribe();
  });
</script>
