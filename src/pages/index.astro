---
import Layout from '../layouts/Layout.astro';
import OnboardingWizard from '../components/dashboard/OnboardingWizard';
import { Shield, Zap, BarChart3, HelpCircle } from 'lucide-react';
---

<Layout title="Welcome | Personal Stock Portfolio Tracker">
  <div class="relative min-h-screen flex flex-col justify-between overflow-hidden">
    
    <!-- Warm glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-gradient-to-b from-accent/5 via-transparent to-transparent blur-[120px] rounded-full pointer-events-none"></div>
 
    <!-- Main Container -->
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 relative z-10 flex flex-col justify-center">
      
      {/* Landing Header */}
      <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12 space-y-4 animate-slide-up" style="animation-delay: 0.05s">
        <div class="inline-flex items-center space-x-1.5 px-3 py-1 bg-accent/10 border border-accent/20 rounded text-xs font-semibold text-accent">
          <Zap size={12} className="text-accent" />
          <span>Active local telemetry enabled</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight font-heading">
          Antigravity <br/>
          <span class="bg-gradient-to-r from-accent via-white to-accent bg-clip-text text-transparent">Stock Portfolio Analytics</span>
        </h1>
        <p class="text-xs sm:text-sm text-slate-400 max-w-xl mx-auto font-sans leading-relaxed">
          Secure client-side parsing protocols for Zerodha, Groww, and US Brokerages. 
          Upload your transactions index to compile real-time market allocations and insights.
        </p>
      </div>
 
      {/* Onboarding Wizard React Island */}
      <div class="mb-12 sm:mb-16 animate-slide-up" style="animation-delay: 0.15s">
        <OnboardingWizard client:load />
      </div>
 
      {/* Feature Grids */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto animate-slide-up" style="animation-delay: 0.25s">
        <div class="cyber-card p-6 space-y-3">
          <div class="absolute -top-2.5 -right-2.5 hotspot-plus">+</div>
          <div class="p-2.5 bg-accent/10 border border-accent/20 text-accent rounded-xl w-fit">
            <Shield size={18} />
          </div>
          <h3 class="text-sm font-bold text-white tracking-tight">01. Local Data Isolation</h3>
          <p class="text-xs text-slate-400 leading-relaxed font-sans">
            Your transaction spreadsheets and records parse entirely in your browser memory. 
            Financial information is cached locally and never sent to external servers.
          </p>
        </div>
 
        <div class="stone-card p-6 space-y-3">
          <div class="absolute -top-2.5 -right-2.5 hotspot-plus">+</div>
          <div class="p-2.5 bg-white/[0.08] border border-white/[0.1] text-white rounded-xl w-fit">
            <Zap size={18} />
          </div>
          <h3 class="text-sm font-bold text-white tracking-tight">02. Real-Time Price Aggregator</h3>
          <p class="text-xs text-slate-350 leading-relaxed font-sans">
            Connects to active index price channels for real-time portfolio updates. 
            Background refreshes adjust automatically to conserve system resource footprint.
          </p>
        </div>
 
        <div class="cyber-card p-6 space-y-3">
          <div class="absolute -top-2.5 -right-2.5 hotspot-plus">+</div>
          <div class="p-2.5 bg-accent/10 border border-accent/20 text-accent rounded-xl w-fit">
            <BarChart3 size={18} />
          </div>
          <h3 class="text-sm font-bold text-white tracking-tight">03. Diversification Audit</h3>
          <p class="text-xs text-slate-400 leading-relaxed font-sans">
            Intelligent calculation engines review asset classes and custodian weights 
            to flag high risk exposures and estimate yearly dividend yields.
          </p>
        </div>
      </div>
 
    </main>
 
    <!-- Footer -->
    <footer class="w-full border-t border-white/[0.04] py-6 text-center text-xs text-slate-500 relative z-10 font-sans">
      <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-3">
        <span>© {new Date().getFullYear()} Antigravity. Sandboxed client-side processing.</span>
        <div class="flex items-center space-x-4">
          <a href="#" class="hover:text-slate-350 transition">Security Settings</a>
          <span>•</span>
          <a href="#" class="hover:text-slate-350 transition">Terms of Use</a>
        </div>
      </div>
    </footer>
  </div>
</Layout>
