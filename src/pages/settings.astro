---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/layout/Navigation';
import SettingsPanel from '../components/dashboard/SettingsPanel';
---

<Layout title="Preferences & Settings | Portfolio Tracker">
  <div class="min-h-screen flex flex-col bg-transparent text-slate-100 pb-12">
    
    {/* Sticky Navigation Bar */}
    <Navigation client:load />

    {/* Content Container */}
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
      
      {/* Page Header */}
      <div class="border-b border-slate-800 pb-4">
        <h1 class="text-2xl font-extrabold tracking-tight text-white font-sans">User Settings & Preferences</h1>
        <p class="text-xs text-slate-400">Configure financial display locales, adjust poll rates, or manage local browser data caches.</p>
      </div>

      {/* Settings Panel React Island */}
      <SettingsPanel client:load />

    </main>
  </div>
</Layout>
