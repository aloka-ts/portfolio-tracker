---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/layout/Navigation';
import HeroStats from '../components/dashboard/HeroStats';
import HoldingsTable from '../components/dashboard/HoldingsTable';
import AllocationCharts from '../components/dashboard/AllocationCharts';
import AIInsights from '../components/dashboard/AIInsights';
import PlatformBreakdown from '../components/dashboard/PlatformBreakdown';
---

<Layout title="Dashboard | Stock Portfolio Analytics">
  <div class="min-h-screen flex flex-col bg-transparent text-slate-100 pb-12">
    
    {/* Navigation Bar React Island */}
    <Navigation client:load />

    {/* Main Content Area */}
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
      
      {/* 1. Hero Statistics Section */}
      <div class="animate-slide-up" style="animation-delay: 0.05s">
        <HeroStats client:load />
      </div>

      {/* 2. Main Grid Layout */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
        
        {/* Left Column (Holdings Table & Platform Cards) - Takes 2 cols */}
        <div className="lg:col-span-2 space-y-6 animate-slide-up" style="animation-delay: 0.15s">
          <HoldingsTable client:load />
          
          <PlatformBreakdown client:load />
        </div>

        {/* Right Column (Allocation Charts & AI Insights) - Takes 1 col */}
        <div className="space-y-6 animate-slide-up" style="animation-delay: 0.25s">
          <AllocationCharts client:load />
          
          <AIInsights client:load />
        </div>

      </div>

    </main>
  </div>
</Layout>

{/* Client script to boot price tickers */}
<script>
  import { startPriceSubscription } from '../stores/prices';
  
  // Start the background subscription
  const unsubscribe = startPriceSubscription();
  
  // Gracefully clean up on page teardown
  document.addEventListener('astro:before-swap', () => {
    if (unsubscribe) unsubscribe();
  });
</script>
