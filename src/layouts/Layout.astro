---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Institutional Stock Tracker', 
  description = 'A lightweight, public-facing personal stock portfolio tracker. Upload your Google Sheets / CSV files directly to view real-time data visualizations.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="theme-transition">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- OpenGraph SEO -->
    <meta property="og:title" content={`${title} | WealthFlow Portfolio`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    
    <title>{title} | WealthFlow Portfolio</title>
 
    <!-- Inline script to set the theme from localStorage before render to prevent flash -->
    <!-- Resolve logic duplicated in src/lib/theme.ts — keep in sync -->
    <script is:inline>
      document.documentElement.classList.toggle('dark', localStorage.getItem('theme') !== 'light');
    </script>
  </head>
  <body class="theme-transition min-h-screen flex flex-col antialiased selection:bg-accent/30 selection:text-white relative bg-navy-950 overflow-x-hidden">
    
    <!-- Background visual layer (Hardware-accelerated for parallax shifting) -->
    <div id="bg-visual-layer" class="fixed inset-0 pointer-events-none z-0 overflow-hidden" style="will-change: transform; transform: translate3d(0,0,0); backface-visibility: hidden; transition: transform 0.15s cubic-bezier(0.25, 1, 0.5, 1);">
      <!-- 1. Fine grid pattern fading in from the top -->
      <div class="bg-grid-pattern absolute inset-0"></div>

      <!-- 2. Top horizon aurora glow behind the nav -->
      <div class="aurora-glow w-[1000px] h-[520px] -top-72 left-1/2" style="background: radial-gradient(ellipse at center, var(--aurora-1) 0%, transparent 65%);"></div>

      <!-- 3. Ambient moving glow blobs (GPU-friendly radial gradients, theme-aware) -->
      <div class="glow-blob w-[500px] h-[500px] -top-40 -left-24" style="background: radial-gradient(circle, var(--aurora-1) 0%, transparent 70%); animation-delay: 0s;"></div>
      <div class="glow-blob w-[550px] h-[550px] top-[38%] -right-40" style="background: radial-gradient(circle, var(--aurora-3) 0%, transparent 70%); animation-delay: -7s;"></div>
      <div class="glow-blob w-[460px] h-[460px] -bottom-24 left-[28%]" style="background: radial-gradient(circle, var(--aurora-2) 0%, transparent 70%); animation-delay: -13s;"></div>

      <!-- 4. Interactive Particle Constellation Canvas (Hardware Accelerated Layer) -->
      <canvas id="particle-canvas" class="absolute inset-0 w-full h-full opacity-[0.20] pointer-events-none" style="will-change: transform; transform: translate3d(0,0,0); backface-visibility: hidden;"></canvas>

      <!-- 5. Background Stock Path SVG -->
      <svg class="absolute top-[25%] left-0 w-full h-[45%] opacity-[0.03] text-accent stroke-current" fill="none" stroke-width="2.5" viewBox="0 0 1000 400" preserveAspectRatio="none">
        <path class="animate-stock-draw" d="M0,300 L120,270 L220,310 L350,220 L480,260 L600,160 L720,200 L850,90 L1000,130" />
        <path class="animate-stock-draw" d="M0,300 L120,270 L220,310 L350,220 L480,260 L600,160 L720,200 L850,90 L1000,130 L1000,400 L0,400 Z" fill="url(#stock-gradient)" opacity="0.15" stroke="none" />
        <defs>
          <linearGradient id="stock-gradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="currentColor" />
            <stop offset="100%" stop-color="transparent" />
          </linearGradient>
        </defs>
      </svg>

      <!-- 6. Edge vignette for depth (dark mode only) -->
      <div class="bg-vignette absolute inset-0"></div>
    </div>

    <!-- Main Content Container -->
    <div class="relative z-10 flex-1 flex flex-col">
      <slot />
    </div>

    <!-- Particle Constellation and Spotlight Card listener scripts -->
    <script>
      const prefersReducedMotion = () =>
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Interactive Particle Constellation
      function initParticles() {
        if (prefersReducedMotion()) return;
        const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
        if (!canvas) return;

        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        let animationFrameId: number;
        let width = (canvas.width = window.innerWidth);
        let height = (canvas.height = window.innerHeight);

        const particles: Particle[] = [];
        const maxParticles = Math.min(45, Math.floor((width * height) / 32000));
        const connectionDist = 100;
        const limitSq = connectionDist * connectionDist;

        let mouse = { x: null as number | null, y: null as number | null, radius: 120 };

        class Particle {
          x: number;
          y: number;
          vx: number;
          vy: number;
          radius: number;

          constructor() {
            this.x = Math.random() * width;
            this.y = Math.random() * height;
            this.vx = (Math.random() - 0.5) * 0.35;
            this.vy = (Math.random() - 0.5) * 0.35;
            this.radius = Math.random() * 1.2 + 0.8;
          }

          update() {
            this.x += this.vx;
            this.y += this.vy;

            if (this.x < 0 || this.x > width) this.vx *= -1;
            if (this.y < 0 || this.y > height) this.vy *= -1;

            // React to mouse (only if close)
            if (mouse.x !== null && mouse.y !== null) {
              const dx = this.x - mouse.x;
              const dy = this.y - mouse.y;
              const distSq = dx * dx + dy * dy;
              const mRadiusSq = mouse.radius * mouse.radius;
              if (distSq < mRadiusSq) {
                const dist = Math.sqrt(distSq);
                const force = (mouse.radius - dist) / mouse.radius;
                this.x += (dx / dist) * force * 1.2;
                this.y += (dy / dist) * force * 1.2;
              }
            }
          }

          draw() {
            if (!ctx) return;
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(74, 222, 128, 0.4)';
            ctx.fill();
          }
        }

        // Initialize particle array
        for (let i = 0; i < maxParticles; i++) {
          particles.push(new Particle());
        }

        function animate() {
          if (!ctx || !canvas) return;
          ctx.clearRect(0, 0, width, height);

          // Draw particles
          particles.forEach((p) => {
            p.update();
            p.draw();
          });

          // Draw connecting lines (Optimized with squared distance check)
          for (let i = 0; i < particles.length; i++) {
            for (let j = i + 1; j < particles.length; j++) {
              const dx = particles[i].x - particles[j].x;
              const dy = particles[i].y - particles[j].y;
              const distSq = dx * dx + dy * dy;

              if (distSq < limitSq) {
                const dist = Math.sqrt(distSq);
                const alpha = (1 - dist / connectionDist) * 0.14;
                ctx.beginPath();
                ctx.moveTo(particles[i].x, particles[i].y);
                ctx.lineTo(particles[j].x, particles[j].y);
                ctx.strokeStyle = `rgba(34, 197, 94, ${alpha})`;
                ctx.lineWidth = 0.6;
                ctx.stroke();
              }
            }
          }

          animationFrameId = requestAnimationFrame(animate);
        }

        // Event Listeners
        const handleMouseMove = (e: MouseEvent) => {
          mouse.x = e.clientX;
          mouse.y = e.clientY;
        };

        const handleMouseLeave = () => {
          mouse.x = null;
          mouse.y = null;
        };

        const handleResize = () => {
          width = canvas.width = window.innerWidth;
          height = canvas.height = window.innerHeight;
        };

        window.addEventListener('mousemove', handleMouseMove);
        window.addEventListener('mouseleave', handleMouseLeave);
        window.addEventListener('resize', handleResize);

        animate();

        return () => {
          cancelAnimationFrame(animationFrameId);
          window.removeEventListener('mousemove', handleMouseMove);
          window.removeEventListener('mouseleave', handleMouseLeave);
          window.removeEventListener('resize', handleResize);
        };
      }

      // 2. Spotlight Card Mouse Move Handler (Optimized Event Delegation with 3D Perspective Tilt)
      function initSpotlightCards() {
        if (prefersReducedMotion()) return;
        const handleMouseOver = (e: MouseEvent) => {
          const card = (e.target as HTMLElement).closest('.glow-card') as HTMLElement;
          if (card && !card.dataset.hasSpotlight) {
            card.dataset.hasSpotlight = 'true';
            
            const handleMouseMove = (innerEvent: MouseEvent) => {
              const rect = card.getBoundingClientRect();
              const x = innerEvent.clientX - rect.left;
              const y = innerEvent.clientY - rect.top;
              
              // 1. Update Spotlight glow position
              card.style.setProperty('--mouse-x', `${x}px`);
              card.style.setProperty('--mouse-y', `${y}px`);
              
              // 2. 3D Tilt calculations
              const cardWidth = rect.width;
              const cardHeight = rect.height;
              const centerX = rect.left + cardWidth / 2;
              const centerY = rect.top + cardHeight / 2;
              const mouseX = innerEvent.clientX - centerX;
              const mouseY = innerEvent.clientY - centerY;
              
              // Tilt max 6 degrees for tactile 3D effect
              const rotateX = -(mouseY / (cardHeight / 2)) * 6;
              const rotateY = (mouseX / (cardWidth / 2)) * 6;
              
              card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.015, 1.015, 1.015)`;
            };
            
            card.addEventListener('mousemove', handleMouseMove);
            card.addEventListener('mouseleave', () => {
              card.removeEventListener('mousemove', handleMouseMove);
              card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
              delete card.dataset.hasSpotlight;
            }, { once: true });
          }
        };
        document.addEventListener('mouseover', handleMouseOver);
        return () => {
          document.removeEventListener('mouseover', handleMouseOver);
        };
      }

      // 3. Background Mouse Parallax Effect (Widescreen Depth)
      function initBackgroundParallax() {
        if (prefersReducedMotion()) return;
        const bgLayer = document.getElementById('bg-visual-layer');
        if (!bgLayer) return;

        const handleMouseMove = (e: MouseEvent) => {
          const x = (e.clientX - window.innerWidth / 2) * -0.008;
          const y = (e.clientY - window.innerHeight / 2) * -0.008;
          bgLayer.style.transform = `translate3d(${x}px, ${y}px, 0) scale(1.01)`;
        };

        window.addEventListener('mousemove', handleMouseMove);
        return () => {
          window.removeEventListener('mousemove', handleMouseMove);
        };
      }

      // Initialize on load and on page swap
      let cleanParticles = initParticles();
      let cleanSpotlight = initSpotlightCards();
      let cleanParallax = initBackgroundParallax();

      document.addEventListener('astro:after-swap', () => {
        if (cleanParticles) cleanParticles();
        if (cleanSpotlight) cleanSpotlight();
        if (cleanParallax) cleanParallax();
        cleanParticles = initParticles();
        cleanSpotlight = initSpotlightCards();
        cleanParallax = initBackgroundParallax();
      });
    </script>
  </body>
</html>
